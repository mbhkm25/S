create policy platform_admin_select_pro_payment_receipts on storage.objects as permissive for select to authenticated using (((bucket_id = 'operation-files'::text) AND ((storage.foldername(name))[1] = 'pro-payment-receipts'::text) AND is_current_platform_admin()));

drop policy if exists storage_delete_pro_payment_receipts on storage.objects;
create policy storage_delete_pro_payment_receipts on storage.objects as permissive for delete to authenticated using (((bucket_id = 'operation-files'::text) AND ((storage.foldername(name))[1] = 'pro-payment-receipts'::text) AND ((storage.foldername(name))[2] = (( SELECT auth.uid() AS uid))::text)));

