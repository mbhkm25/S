create policy business_community_settings_public_read on public.business_community_settings as permissive for select to anon, authenticated using ((singleton = true));

drop policy if exists business_customer_relationship_events_select_context on public.business_customer_relationship_events;
create policy business_customer_relationship_events_select_context on public.business_customer_relationship_events as permissive for select to authenticated using (((customer_user_id = auth.uid()) OR (EXISTS ( SELECT 1
   FROM business_profiles bp
  WHERE ((bp.id = business_customer_relationship_events.business_id) AND (bp.owner_user_id = auth.uid())))) OR is_platform_admin(auth.uid())));

drop policy if exists business_customers_select_context on public.business_customers;
create policy business_customers_select_context on public.business_customers as permissive for select to authenticated using (((user_id = ( SELECT auth.uid() AS uid)) OR (EXISTS ( SELECT 1
   FROM business_profiles bp
  WHERE ((bp.id = business_customers.business_id) AND (bp.owner_user_id = ( SELECT auth.uid() AS uid)))))));

drop policy if exists business_financial_account_events_select_owner on public.business_financial_account_events;
create policy business_financial_account_events_select_owner on public.business_financial_account_events as permissive for select to authenticated using ((EXISTS ( SELECT 1
   FROM business_profiles bp
  WHERE ((bp.id = business_financial_account_events.business_id) AND ((bp.owner_user_id = ( SELECT auth.uid() AS uid)) OR is_platform_admin(( SELECT auth.uid() AS uid)))))));

drop policy if exists business_financial_accounts_select_owner on public.business_financial_accounts;
create policy business_financial_accounts_select_owner on public.business_financial_accounts as permissive for select to authenticated using ((EXISTS ( SELECT 1
   FROM business_profiles bp
  WHERE ((bp.id = business_financial_accounts.business_id) AND ((bp.owner_user_id = ( SELECT auth.uid() AS uid)) OR is_platform_admin(( SELECT auth.uid() AS uid)))))));

drop policy if exists business_financial_identifiers_select_owner on public.business_financial_identifiers;
create policy business_financial_identifiers_select_owner on public.business_financial_identifiers as permissive for select to authenticated using ((EXISTS ( SELECT 1
   FROM (business_financial_accounts a
     JOIN business_profiles bp ON ((bp.id = a.business_id)))
  WHERE ((a.id = business_financial_identifiers.financial_account_id) AND ((bp.owner_user_id = ( SELECT auth.uid() AS uid)) OR is_platform_admin(( SELECT auth.uid() AS uid)))))));

drop policy if exists business_inquiries_select_context on public.business_inquiries;
create policy business_inquiries_select_context on public.business_inquiries as permissive for select to authenticated using (((customer_user_id = ( SELECT auth.uid() AS uid)) OR (EXISTS ( SELECT 1
   FROM business_profiles bp
  WHERE ((bp.id = business_inquiries.business_id) AND (bp.owner_user_id = ( SELECT auth.uid() AS uid)))))));

drop policy if exists business_invitations_select_context on public.business_invitations;
create policy business_invitations_select_context on public.business_invitations as permissive for select to authenticated using (((invited_user_id = ( SELECT auth.uid() AS uid)) OR (invited_phone = ( SELECT p.phone
   FROM profiles p
  WHERE (p.id = ( SELECT auth.uid() AS uid)))) OR (created_by_user_id = ( SELECT auth.uid() AS uid)) OR (EXISTS ( SELECT 1
   FROM business_profiles bp
  WHERE ((bp.id = business_invitations.business_id) AND (bp.owner_user_id = ( SELECT auth.uid() AS uid)))))));

drop policy if exists business_media_assets_select_context on public.business_media_assets;
create policy business_media_assets_select_context on public.business_media_assets as permissive for select to authenticated using (((status = 'active'::text) AND (EXISTS ( SELECT 1
   FROM business_profiles bp
  WHERE ((bp.id = business_media_assets.business_id) AND ((bp.public_status = 'published'::text) OR (bp.owner_user_id = ( SELECT auth.uid() AS uid)) OR (EXISTS ( SELECT 1
           FROM business_team_members tm
          WHERE ((tm.business_id = bp.id) AND (tm.user_id = ( SELECT auth.uid() AS uid)) AND (tm.status = 'active'::text))))))))));

drop policy if exists business_operation_links_select_context on public.business_operation_links;
create policy business_operation_links_select_context on public.business_operation_links as permissive for select to authenticated using (((linked_by_user_id = ( SELECT auth.uid() AS uid)) OR (EXISTS ( SELECT 1
   FROM business_profiles bp
  WHERE ((bp.id = business_operation_links.business_id) AND (bp.owner_user_id = ( SELECT auth.uid() AS uid))))) OR (EXISTS ( SELECT 1
   FROM business_team_members tm
  WHERE ((tm.business_id = business_operation_links.business_id) AND (tm.user_id = ( SELECT auth.uid() AS uid)) AND (tm.status = 'active'::text))))));

