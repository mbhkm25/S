drop policy if exists ai_prompts_no_client_read on public.ai_prompts;
create policy ai_prompts_no_client_read on public.ai_prompts as permissive for select to authenticated using (false);

drop policy if exists business_catalog_items_select_context on public.business_catalog_items;
create policy business_catalog_items_select_context on public.business_catalog_items as permissive for select to authenticated using ((((status = 'active'::text) AND (EXISTS ( SELECT 1
   FROM business_profiles bp
  WHERE ((bp.id = business_catalog_items.business_id) AND (bp.public_status = 'published'::text))))) OR (EXISTS ( SELECT 1
   FROM business_profiles bp
  WHERE ((bp.id = business_catalog_items.business_id) AND (bp.owner_user_id = ( SELECT auth.uid() AS uid)))))));

drop policy if exists business_categories_select_anon on public.business_categories;
create policy business_categories_select_anon on public.business_categories as permissive for select to anon using ((status = 'active'::text));

drop policy if exists business_categories_select_authenticated on public.business_categories;
create policy business_categories_select_authenticated on public.business_categories as permissive for select to authenticated using ((status = 'active'::text));

drop policy if exists business_community_interest_own_insert on public.business_community_interest;
create policy business_community_interest_own_insert on public.business_community_interest as permissive for insert to authenticated with check ((( SELECT auth.uid() AS uid) = user_id));

drop policy if exists business_community_interest_own_select on public.business_community_interest;
create policy business_community_interest_own_select on public.business_community_interest as permissive for select to authenticated using ((( SELECT auth.uid() AS uid) = user_id));

