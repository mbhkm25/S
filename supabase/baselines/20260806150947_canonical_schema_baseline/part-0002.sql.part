drop policy if exists business_profiles_select_authenticated_context on public.business_profiles;
create policy business_profiles_select_authenticated_context on public.business_profiles as permissive for select to authenticated using (((public_status = 'published'::text) OR (owner_user_id = ( SELECT auth.uid() AS uid)) OR (EXISTS ( SELECT 1
   FROM business_team_members tm
  WHERE ((tm.business_id = business_profiles.id) AND (tm.user_id = ( SELECT auth.uid() AS uid)) AND (tm.status = 'active'::text)))) OR (EXISTS ( SELECT 1
   FROM business_customers bc
  WHERE ((bc.business_id = business_profiles.id) AND (bc.user_id = ( SELECT auth.uid() AS uid)) AND (bc.status = 'active'::text))))));

