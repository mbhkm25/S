{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:admin": "vite --config admin/vite.config.ts --port=3001 --host=0.0.0.0",
    "build": "vite build --configLoader bundle",
    "build:admin": "vite build --config admin/vite.config.ts --configLoader bundle",
    "build:android": "python scripts/generate-sanad-icons.py && vite build --mode android",
    "cap:sync": "npx cap sync android",
    "preview": "vite preview",
    "preview:admin": "vite preview --config admin/vite.config.ts --port=4174",
    "check:routes": "tsx scripts/check-app-routes.ts && tsx scripts/check-email-action-entrypoints.ts",
    "test:pipeline:load": "node scripts/operation-pipeline-db-load.mjs",
    "deploy:production": "gh workflow run deploy-production.yml --ref main",
    "clean": "rm -rf dist dist-admin server.js",
    "lint": "tsc --noEmit",
    "audit:migrations": "node scripts/audit-supabase-migration-history.mjs --mode audit",
    "gate:migrations": "node scripts/audit-supabase-migration-history.mjs --mode deploy-gate",
    "test:migration-audit": "node --test scripts/audit-supabase-migration-history.test.mjs",
    "verify:canonical-baseline": "node scripts/verify-supabase-canonical-baseline.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
