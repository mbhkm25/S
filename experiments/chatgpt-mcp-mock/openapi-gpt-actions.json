{
  "openapi": "3.1.0",
  "info": {
    "title": "SANAD Synthetic Accounting Demo — GPT Actions",
    "version": "0.0.1",
    "description": "Demonstration ONLY: fabricated business and accounts. No connection to real SANAD/Supabase/Edaa data."
  },
  "servers": [
    {
      "url": "https://REPLACE-WITH-CURRENT-TUNNEL.trycloudflare.com"
    }
  ],
  "paths": {
    "/gpt-demo/businesses": {
      "get": {
        "operationId": "sanadDemoListBusinesses",
        "summary": "List fabricated demonstration businesses",
        "description": "Returns fabricated test business. Always label results as demo.",
        "responses": {
          "200": {
            "description": "Synthetic businesses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/gpt-demo/sync": {
      "get": {
        "operationId": "sanadDemoSyncStatus",
        "summary": "Simulated sync status for demo business",
